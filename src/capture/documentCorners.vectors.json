{
  "bleed": 0.04,
  "edgeEpsilon": 0.005,
  "minAreaFraction": 0.05,
  "problems": [
    { "name": "centred card", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.1, "y": 0.2 }, "topRight": { "x": 0.9, "y": 0.2 }, "bottomRight": { "x": 0.9, "y": 0.75 }, "bottomLeft": { "x": 0.1, "y": 0.75 } },
      "expected": null },
    { "name": "nothing detected", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 }, "quad": null, "expected": "no_document" },
    { "name": "passport bottom edge on the frame edge", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.1, "y": 0.3 }, "topRight": { "x": 0.9, "y": 0.3 }, "bottomRight": { "x": 0.9, "y": 1.0 }, "bottomLeft": { "x": 0.1, "y": 1.0 } },
      "expected": "corner_cut_off" },
    { "name": "corner outside the frame", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": -0.05, "y": 0.2 }, "topRight": { "x": 0.9, "y": 0.2 }, "bottomRight": { "x": 0.9, "y": 0.75 }, "bottomLeft": { "x": 0.1, "y": 0.75 } },
      "expected": "corner_cut_off" },
    { "name": "corner clipped at the edge (inside epsilon)", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.003, "y": 0.2 }, "topRight": { "x": 0.9, "y": 0.2 }, "bottomRight": { "x": 0.9, "y": 0.75 }, "bottomLeft": { "x": 0.1, "y": 0.75 } },
      "expected": "corner_cut_off" },
    { "name": "corner inside but within the bleed", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.02, "y": 0.2 }, "topRight": { "x": 0.9, "y": 0.2 }, "bottomRight": { "x": 0.9, "y": 0.75 }, "bottomLeft": { "x": 0.1, "y": 0.75 } },
      "expected": "too_close" },
    { "name": "rotated card well inside", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.15, "y": 0.25 }, "topRight": { "x": 0.85, "y": 0.15 }, "bottomRight": { "x": 0.9, "y": 0.7 }, "bottomLeft": { "x": 0.2, "y": 0.8 } },
      "expected": null },
    { "name": "too small to be a document", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.4, "y": 0.4 }, "topRight": { "x": 0.5, "y": 0.4 }, "bottomRight": { "x": 0.5, "y": 0.45 }, "bottomLeft": { "x": 0.4, "y": 0.45 } },
      "expected": "no_document" },
    { "name": "self-intersecting corners", "visible": { "left": 0, "top": 0, "right": 1, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.1, "y": 0.2 }, "topRight": { "x": 0.9, "y": 0.75 }, "bottomRight": { "x": 0.9, "y": 0.2 }, "bottomLeft": { "x": 0.1, "y": 0.75 } },
      "expected": "no_document" },
    { "name": "corner hidden by the preview's cover crop", "visible": { "left": 0.125, "top": 0, "right": 0.875, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.1, "y": 0.2 }, "topRight": { "x": 0.8, "y": 0.2 }, "bottomRight": { "x": 0.8, "y": 0.7 }, "bottomLeft": { "x": 0.2, "y": 0.7 } },
      "expected": "corner_cut_off" },
    { "name": "inside the cover crop with room", "visible": { "left": 0.125, "top": 0, "right": 0.875, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.2, "y": 0.2 }, "topRight": { "x": 0.8, "y": 0.2 }, "bottomRight": { "x": 0.8, "y": 0.7 }, "bottomLeft": { "x": 0.2, "y": 0.7 } },
      "expected": null },
    { "name": "inside the cover crop but within the bleed", "visible": { "left": 0.125, "top": 0, "right": 0.875, "bottom": 1 },
      "quad": { "topLeft": { "x": 0.2, "y": 0.2 }, "topRight": { "x": 0.85, "y": 0.2 }, "bottomRight": { "x": 0.85, "y": 0.7 }, "bottomLeft": { "x": 0.2, "y": 0.7 } },
      "expected": "too_close" }
  ],
  "crops": [
    { "name": "bleed added on every side", "frame": { "width": 1000, "height": 500 },
      "quad": { "topLeft": { "x": 0.1, "y": 0.2 }, "topRight": { "x": 0.9, "y": 0.2 }, "bottomRight": { "x": 0.9, "y": 0.75 }, "bottomLeft": { "x": 0.1, "y": 0.75 } },
      "expected": { "x": 60, "y": 80, "width": 880, "height": 315 } },
    { "name": "clamped to the frame", "frame": { "width": 1000, "height": 500 },
      "quad": { "topLeft": { "x": 0.02, "y": 0.01 }, "topRight": { "x": 0.98, "y": 0.01 }, "bottomRight": { "x": 0.98, "y": 0.99 }, "bottomLeft": { "x": 0.02, "y": 0.99 } },
      "expected": { "x": 0, "y": 0, "width": 1000, "height": 500 } },
    { "name": "rotated card uses its bounding box", "frame": { "width": 1000, "height": 1000 },
      "quad": { "topLeft": { "x": 0.15, "y": 0.25 }, "topRight": { "x": 0.85, "y": 0.15 }, "bottomRight": { "x": 0.9, "y": 0.7 }, "bottomLeft": { "x": 0.2, "y": 0.8 } },
      "expected": { "x": 110, "y": 110, "width": 830, "height": 730 } }
  ],
  "rules": [
    "Order of checks: degenerate (null, not convex, self-intersecting, or area < minAreaFraction of the frame) => no_document; any corner outside the visible region or within edgeEpsilon of its edge => corner_cut_off; any corner within bleed of the visible edge => too_close; else null.",
    "bleed is a fraction of the FRAME width on x and of the FRAME height on y, measured from the visible region's edges.",
    "Crop = quad bounding box expanded by bleed*width on x and bleed*height on y, clamped to the frame, rounded to whole pixels (floor the origin, ceil the far edge)."
  ]
}
